# Copiez en .env (non versionné). Lu automatiquement par docker compose.

# Clé partagée entre Django et le workflow Typebot (en-tête X-Chatbot-Key).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vide = l'API /api/chatbot/ reste fermée.
CHATBOT_API_KEY=
# URL de l'API vue par le navigateur du client (pour les images produits)
CHATBOT_PUBLIC_BASE_URL=http://localhost:8000
# Lues par typebot/build_workflow.py
CHATBOT_API_URL=http://host.docker.internal:8000
CHATBOT_SITE_URL=http://localhost:5173
