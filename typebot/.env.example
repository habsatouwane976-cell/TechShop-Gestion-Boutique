# Copiez en .env (non versionné) puis changez ENCRYPTION_SECRET :
#   openssl rand -base64 24
ENCRYPTION_SECRET=CHANGER_MOI_32_CARACTERES_ALEATOIRES
DATABASE_URL=postgresql://postgres:typebot@typebot-db:5432/typebot
NODE_OPTIONS=--no-node-snapshot

NEXTAUTH_URL=http://localhost:8080
NEXT_PUBLIC_VIEWER_URL=http://localhost:8091
ADMIN_EMAIL=admin@techshop.local

# Envoi du lien de connexion vers Mailpit (http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
NEXT_PUBLIC_SMTP_FROM="TechShop Assistant <noreply@techshop.local>"

# Autorise les blocs « requête HTTP » à joindre Django sur la machine hôte (réseau privé bloqué par défaut)
SSRF_ALLOWED_HOSTS=host.docker.internal
